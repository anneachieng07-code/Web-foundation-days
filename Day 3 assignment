console.log("--- 1. searchNotes ---");
console.log(searchNotes("javascript")); 
// Expected output: [{ id: 4, text: "Revise JavaScript arrays", category: "study" }]

console.log(searchNotes("python")); 
// Expected output: []

console.log("--- 2. longestNote ---");
console.log(longestNote()); 
// Expected output: { id: 3, text: "Email the project report to Grace", category: "work" }

// Edge case for empty array test
const tempNotes = notes;
notes = [];
console.log(longestNote()); 
// Expected output: null
notes = tempNotes; // Restore original array

console.log("--- 3. countByCategory ---");
console.log(countByCategory()); 
// Expected output: { personal: 2, study: 2, work: 1 }

// Edge case with custom single array
const originalNotes = [...notes];
notes = [{ id: 1, text: "Test note", category: "work" }];
console.log(countByCategory()); 
// Expected output: { work: 1 }
notes = [...originalNotes]; // Restore array

console.log("--- 4. getSummary ---");
console.log(getSummary()); 
// Expected output: "5 notes: personal 2, study 2, work 1." (or order of keys)

// Edge case with 1 note
notes = [{ id: 1, text: "Only one", category: "personal" }];
console.log(getSummary()); 
// Expected output: "1 note: personal 1."
notes = [...originalNotes]; // Restore array

console.log("--- 5. isDuplicate ---");
console.log(isDuplicate("  Call mum  ")); 
// Expected output: true

console.log(isDuplicate("Call dad")); 
// Expected output: false

console.log("--- 6. addNote ---");
console.log(addNote("Prepare presentation", "work")); 
// Expected output: true

console.log(addNote("Call mum", "personal")); 
// Expected output: Failed to add: Duplicate note already exists. -> false

console.log(addNote("", "study")); 
// Expected output: Failed to add: Text length must be between 1 and 200 characters. -> false

console.log(addNote("Shopping", "groceries")); 
// Expected output: Failed to add: Invalid category "groceries". Must be personal, work, or study. -> false
