const API_URL = 'https://jsonplaceholder.typicode.com/posts';

// DOM Elements
const loadBtn = document.getElementById('load-btn');
const statusEl = document.getElementById('status');
const noteForm = document.getElementById('note-form');
const titleInput = document.getElementById('title-input');
const bodyInput = document.getElementById('body-input');
const submitBtn = document.getElementById('submit-btn');
const notesList = document.getElementById('notes-list');

// Helper function to update status UI
function showStatus(message, type = 'info') {
  statusEl.textContent = message;
  statusEl.className = `status-message ${type}`;
}

// Reusable async HTTP request function
async function request(url, options = {}) {
  const response = await fetch(url, options);
  if (!response.ok) {
    throw new Error(`HTTP Error! Status: ${response.status}`);
  }
  // Return empty object for empty 204 or non-json responses if necessary
  if (response.status === 204) return {};
  return await response.json();
}

// Render a single note item using textContent safely
function renderNoteItem(note) {
  const li = document.createElement('li');
  li.className = 'note-item';
  li.dataset.id = note.id;

  const contentDiv = document.createElement('div');
  contentDiv.className = 'note-content';

  const h3 = document.createElement('h3');
  h3.textContent = note.title;

  const p = document.createElement('p');
  p.textContent = note.body || '(No content)';

  contentDiv.appendChild(h3);
  contentDiv.appendChild(p);

  const deleteBtn = document.createElement('button');
  deleteBtn.className = 'delete-btn';
  deleteBtn.textContent = 'Delete';
  deleteBtn.addEventListener('click', () => deleteNote(note.id, li));

  li.appendChild(contentDiv);
  li.appendChild(deleteBtn);

  return li;
}

// GET: Load 10 notes
async function loadNotes() {
  loadBtn.disabled = true;
  showStatus('Loading notes...', 'info');

  try {
    const notes = await request(`${API_URL}?_limit=10`);
    notesList.innerHTML = '';

    if (!notes || notes.length === 0) {
      showStatus('No notes found.', 'info');
      const emptyLi = document.createElement('li');
      emptyLi.className = 'empty-state';
      emptyLi.textContent = 'No notes available. Create one above!';
      notesList.appendChild(emptyLi);
      return;
    }

    notes.forEach(note => {
      notesList.appendChild(renderNoteItem(note));
    });

    showStatus('Loaded 10 notes from the server.', 'success');
  } catch (error) {
    showStatus(`Failed to load notes: ${error.message}`, 'error');
  } finally {
    loadBtn.disabled = false;
  }
}

// POST: Create a new note
async function createNote(event) {
  event.preventDefault();

  const title = titleInput.value.trim();
  const body = bodyInput.value.trim();

  // Validation
  if (!title) {
    showStatus('Title is required.', 'error');
    return;
  }
  if (title.length > 100) {
    showStatus('Title must be 100 characters or less.', 'error');
    return;
  }

  submitBtn.disabled = true;
  showStatus('Creating note...', 'info');

  try {
    const payload = { title, body, userId: 1 };
    const newNote = await request(API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    // Remove empty-state message if present
    const emptyState = notesList.querySelector('.empty-state');
    if (emptyState) emptyState.remove();

    // Insert newly created note at the top
    notesList.prepend(renderNoteItem(newNote));

    showStatus(`Note created (status 201, id ${newNote.id}).`, 'success');
    noteForm.reset();
  } catch (error) {
    showStatus(`Failed to create note: ${error.message}`, 'error');
  } finally {
    submitBtn.disabled = false;
  }
}

// DELETE: Remove a note
/*
 * NOTE ON JSONPLACEHOLDER BEHAVIOR:
 * JSONPlaceholder simulates API calls. A DELETE request returns a 200 OK status
 * with an empty object {}, but does not physically modify server database records.
 * Therefore, we manually remove the DOM element on a successful 200 response.
 */
async function deleteNote(id, element) {
  const deleteButtons = document.querySelectorAll('.delete-btn');
  deleteButtons.forEach(btn => btn.disabled = true);
  showStatus(`Deleting note #${id}...`, 'info');

  try {
    await request(`${API_URL}/${id}`, { method: 'DELETE' });
    element.remove();
    showStatus(`Note #${id} deleted successfully.`, 'success');

    if (notesList.children.length === 0) {
      const emptyLi = document.createElement('li');
      emptyLi.className = 'empty-state';
      emptyLi.textContent = 'No notes remaining.';
      notesList.appendChild(emptyLi);
    }
  } catch (error) {
    showStatus(`Failed to delete note: ${error.message}`, 'error');
  } finally {
    deleteButtons.forEach(btn => btn.disabled = false);
  }
}

// Event Listeners
loadBtn.addEventListener('click', loadNotes);
noteForm.addEventListener('submit', createNote);
# QuickNotes REST API Design Document

This document outlines the production RESTful API specification for QuickNotes.

## REST Endpoints Overview

| Method | Path | Description | Success Status |
| :--- | :--- | :--- | :--- |
| `GET` | `/api/v1/notes` | List all notes for the authenticated user | `200 OK` |
| `POST` | `/api/v1/notes` | Create a new note | `201 Created` |
| `GET` | `/api/v1/notes/:id` | Fetch details of a single note | `200 OK` |
| `PUT` | `/api/v1/notes/:id` | Update an existing note completely | `200 OK` |
| `DELETE` | `/api/v1/notes/:id` | Delete a note by ID | `200 OK` or `204 No Content` |
| `GET` | `/api/v1/tags` | List all tags created by the user | `200 OK` |

---

## Request & Response JSON Examples

### 1. Create a Note (`POST /api/v1/notes`)

**Request Body:**
```json
{
  "title": "System Architecture Ideas",
  "body": "Need to decouple background jobs using RabbitMQ.",
  "tag_ids": [1, 3]
}
{
  "id": 101,
  "user_id": 42,
  "title": "System Architecture Ideas",
  "body": "Need to decouple background jobs using RabbitMQ.",
  "tags": [
    { "id": 1, "name": "Architecture" },
    { "id": 3, "name": "Backend" }
  ],
  "created_at": "2026-10-08T10:00:00Z",
  "updated_at": "2026-10-08T10:00:00Z"
}
{
  "total": 2,
  "page": 1,
  "limit": 10,
  "notes": [
    {
      "id": 101,
      "user_id": 42,
      "title": "System Architecture Ideas",
      "body": "Need to decouple background jobs using RabbitMQ.",
      "tags": ["Architecture", "Backend"],
      "created_at": "2026-10-08T10:00:00Z"
    },
    {
      "id": 98,
      "user_id": 42,
      "title": "Grocery List",
      "body": "Milk, Eggs, Coffee beans.",
      "tags": ["Personal"],
      "created_at": "2026-10-07T14:30:00Z"
    }
  ]
}
{
  "error": {
    "code": "INVALID_INPUT",
    "message": "Title is required and must not exceed 100 characters.",
    "status": 400,
    "timestamp": "2026-10-08T10:05:00Z"
  }
}
# QuickNotes System Design & API Client

A full-stack API client implementation and architecture specification for scaling the **QuickNotes** service to 1 million users.

## Project Structure

```text
quicknotes-system-design/
├── index.html          # HTML5 interface for notes management
├── style.css           # Styling for application and status messages
├── api.js              # Fetch client interacting with JSONPlaceholder API
├── docs/
│   ├── api-design.md   # REST API endpoint specification and errors
│   ├── data-model.md   # PostgreSQL schema, queries, and indexing
│   └── architecture.md # System architecture, load estimates, and flows
└── README.md           # Documentation overview
